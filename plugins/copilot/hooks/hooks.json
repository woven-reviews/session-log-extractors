{
  "version": 1,
  "hooks": {
    "preToolUse": [{"type": "command", "exec": "${COPILOT_PLUGIN_ROOT}/bin/session-log-hook.exe", "args": ["pre", "copilot"], "timeoutSec": 15}],
    "agentStop": [{"type": "command", "exec": "${COPILOT_PLUGIN_ROOT}/bin/session-log-hook.exe", "args": ["stop", "copilot"], "timeoutSec": 15}],
    "sessionStart": [{"type": "command", "exec": "${COPILOT_PLUGIN_ROOT}/bin/session-log-hook.exe", "args": ["notice", "copilot"], "timeoutSec": 15}]
  }
}
